# === MPPPL — NUNCA comitar estes arquivos ===

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# Node
node_modules/
dist/
.DS_Store

# Environment (contém tokens, caminhos locais, chaves)
.env
.env.*
!.env.example

# Logs (contêm dados operacionais)
logs/
*.log

# Config local
*.local

# Dados sensíveis / clientes
**/processos.db
**/faiss/**
**/idx_processos/**
data/**

# Dados do usuário
~/.hermes/**
.hermes/**

# Chaves SSH / GPG
*.pem
*.key
*.cer
*.p12

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.worktrees/
